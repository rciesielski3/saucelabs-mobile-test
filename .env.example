# Optional overrides. Copy to .env (git-ignored). Real environment variables win over .env.
# npm run test:android / test:ios already set PLATFORM and APP_FOLDER.
PLATFORM=Android            # Android | iOS (used by `npm test`)
PLATFORM_VERSION=15         # e.g. 15 (Android) or 17.0 (iOS)
DEVICE_NAME=emulator-5554   # emulator/simulator/device name
APP_FOLDER=./assets/android # folder containing the .apk (Android) or .app/.zip (iOS)
