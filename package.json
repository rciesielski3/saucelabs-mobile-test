{
  "name": "saucelabs-mobile-test",
  "version": "1.0.0",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:android": "PLATFORM=Android APP_FOLDER=./assets/android wdio run wdio.conf.ts",
    "test:ios": "PLATFORM=iOS APP_FOLDER=./assets/ios wdio run wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Rafał Ciesielski",
  "license": "MIT",
  "description": "WebdriverIO + Appium + TypeScript mobile E2E tests for the Swag Labs sample app",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@wdio/appium-service": "^9.18.1",
    "@wdio/cli": "^9.18.1",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.18.1",
    "@wdio/mocha-framework": "^9.18.0",
    "@wdio/spec-reporter": "^9.18.0",
    "@wdio/types": "^9.16.2",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.5",
    "appium-xcuitest-driver": "^9.9.6",
    "dotenv": "^17.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "webdriverio": "^9.18.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
